{
  "name": "ForumPost",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "reflexion",
        "herramienta",
        "pensamiento"
      ],
      "default": "reflexion"
    },
    "reactions": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "topic_id",
    "content"
  ]
}