# Variables de entorno necesarias para conectar este frontend
# con tu backend alojado en Base44.
#
# 1. Copiá este archivo y renombralo a .env.local (para desarrollo local)
#    o cargá estos mismos nombres/valores en el panel de variables de
#    entorno de tu plataforma de hosting (Vercel, Netlify, Render, etc.)
#
# 2. VITE_BASE44_APP_ID ya viene completado: es el ID de ESTE proyecto
#    (lo tomamos de base44/.app.jsonc). OJO: es distinto al de
#    otros proyectos que hayas exportado antes.
VITE_BASE44_APP_ID=6a4f1101572ca9dba6c7642f

# 3. VITE_BASE44_APP_BASE_URL: la URL pública de ESTA app publicada
#    en Base44. La ves en tu dashboard de Base44, arriba del editor,
#    en el botón "Publish" o "Preview". Algo como:
#    https://nombre-de-tu-app.base44.app
VITE_BASE44_APP_BASE_URL=https://tu-app.base44.app
