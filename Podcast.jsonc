{
  "name": "Podcast",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "adultos",
        "adolescentes"
      ]
    },
    "description": {
      "type": "string"
    },
    "embed_url": {
      "type": "string"
    },
    "episode_number": {
      "type": "number"
    },
    "cover_image": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "category"
  ]
}