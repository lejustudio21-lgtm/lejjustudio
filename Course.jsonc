{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "curso",
        "taller"
      ],
      "default": "curso"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "image": {
      "type": "string"
    },
    "content_url": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "is_premium": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}